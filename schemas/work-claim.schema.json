{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vazhi/canto-span/schemas/work-claim.schema.json",
  "title": "Canto Span semantic work claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "work_id",
    "status",
    "claim_mode",
    "integration_role",
    "branch",
    "expires_at",
    "targets",
    "generated_outputs",
    "protected_state",
    "dependencies",
    "summary"
  ],
  "properties": {
    "schema": { "const": "canto-span-work-claim-v1" },
    "work_id": { "type": "string", "pattern": "^CS-WORK-[0-9]{4,}$" },
    "status": { "enum": ["active", "stale", "complete"] },
    "claim_mode": { "enum": ["shared", "exclusive"] },
    "integration_role": { "enum": ["worker", "integrator"] },
    "branch": { "type": "string", "pattern": "^agent/[a-z0-9][a-z0-9._/-]*$" },
    "expires_at": { "type": "string", "format": "date-time" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type"],
        "properties": {
          "type": {
            "enum": ["file", "construction", "state_dimension", "survey", "corpus_packet", "schema", "workflow", "generated_output"]
          },
          "path": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "region": { "type": "string", "minLength": 1 }
        },
        "oneOf": [
          { "required": ["path"] },
          { "required": ["id"] }
        ]
      }
    },
    "generated_outputs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "protected_state": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "dependencies": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "integer", "minimum": 1 },
          { "type": "string", "pattern": "^CS-WORK-[0-9]{4,}$" }
        ]
      },
      "uniqueItems": true
    },
    "summary": { "type": "string", "minLength": 1 }
  }
}
