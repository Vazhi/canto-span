{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vazhi/canto-span/schemas/pedagogical-corpus-registry.schema.json",
  "title": "Canto Span pedagogical-corpus package registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registry_state", "package_root", "packages", "migration_queue", "invariants"],
  "properties": {
    "schema": {"const": "canto-span-pedagogical-corpus-registry-v1"},
    "registry_state": {"enum": ["foundation", "active"]},
    "package_root": {"$ref": "#/$defs/repositoryPath"},
    "packages": {"type": "array", "items": {"$ref": "#/$defs/packageEntry"}},
    "migration_queue": {"type": "array", "items": {"$ref": "#/$defs/migrationEntry"}},
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["closed_package_manifests", "safe_path_containment", "recompute_byte_and_semantic_hashes", "registry_wide_duplicate_dag", "registry_wide_route_ownership", "exact_bidirectional_projections"],
      "properties": {
        "closed_package_manifests": {"const": true},
        "safe_path_containment": {"const": true},
        "recompute_byte_and_semantic_hashes": {"const": true},
        "registry_wide_duplicate_dag": {"const": true},
        "registry_wide_route_ownership": {"const": true},
        "exact_bidirectional_projections": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"registry_state": {"const": "foundation"}}},
      "then": {"properties": {"packages": {"maxItems": 0}, "migration_queue": {"minItems": 1}}}
    },
    {
      "if": {"properties": {"registry_state": {"const": "active"}}},
      "then": {"properties": {"packages": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[^\\u0000]+$"
    },
    "authorityState": {"enum": ["preserved", "mechanical", "reviewed", "accepted", "superseded", "withdrawn"]},
    "packageEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "package_kind", "root", "manifest", "authority_state", "authority_issue"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "package_kind": {"enum": ["weekly", "dialog", "other"]},
        "root": {"$ref": "#/$defs/repositoryPath"},
        "manifest": {"$ref": "#/$defs/repositoryPath"},
        "authority_state": {"$ref": "#/$defs/authorityState"},
        "authority_issue": {"type": ["integer", "null"], "minimum": 1}
      }
    },
    "migrationEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["package_id", "source_issue", "stale_claim", "stale_pr", "source_root"],
      "properties": {
        "package_id": {"type": "string", "minLength": 1},
        "source_issue": {"type": "integer", "minimum": 1},
        "stale_claim": {"type": "integer", "minimum": 1},
        "stale_pr": {"type": "integer", "minimum": 1},
        "source_root": {"$ref": "#/$defs/repositoryPath"}
      }
    }
  }
}
