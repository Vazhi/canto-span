{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Vazhi/canto-span/schemas/pedagogical-corpus-review-events.schema.json",
  "title": "Canto Span pedagogical-corpus review events",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "events"],
  "properties": {
    "schema": {"const": "canto-span-pedagogical-review-events-v1"},
    "events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "record_id", "event_type", "reviewer_role", "reviewed_source_semantic_sha256", "decision_at", "decision_type", "evidence_basis", "replacement_authority_issue"],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "record_id": {"type": "string", "minLength": 1},
        "event_type": {"enum": ["review", "acceptance", "supersession", "withdrawal"]},
        "reviewer_role": {"enum": ["project_reviewer", "external_expert", "native_reviewer"]},
        "reviewed_source_semantic_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decision_at": {"type": "string", "format": "date-time"},
        "decision_type": {"enum": ["genuine", "false_positive", "ambiguous", "unusable", "observation", "accepted_correction", "superseded", "withdrawn"]},
        "evidence_basis": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "replacement_authority_issue": {"type": ["integer", "null"], "minimum": 1}
      }
    }
  }
}
