      "ordinal": 13,
      "itemType": "dialog_turn",
      "turn": 13,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:有冇芒果蛋糕呀?",
        "traditional": "有冇芒果蛋糕呀?",
        "jyutpingLine": "/Aa3 Saan1: Jau5 mou5 mong1 gwo2 daan6 gou1 aa3?/",
