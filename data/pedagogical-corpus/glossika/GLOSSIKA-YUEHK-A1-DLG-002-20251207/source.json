      "ordinal": 4,
      "itemType": "dialog_turn",
      "turn": 4,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:呢個一百八十蚊。",
        "traditional": "呢個一百八十蚊。",
        "jyutpingLine": "/Dim3 Jyun4: Ni1 go3 jat1 baak3 baat3 sap6 man1./",
        "english": null
