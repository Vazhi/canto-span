      "ordinal": 2,
      "itemType": "dialog_turn",
      "turn": 2,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:係呀,呢個係我哋新款。",
        "traditional": "係呀,呢個係我哋新款。",
        "jyutpingLine": "/Dim3 Jyun4: Hai6 aa3, ni1 go3 hai6 ngo5 dei6 san1 fun2./",
