    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I017",
      "ordinal": 17,
      "itemType": "dialog_turn",
      "turn": 17,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:點解平咗呀?",
        "traditional": "點解平咗呀?",
        "jyutpingLine": "/Aa3 Saan1: Dim2 gaai2 peng4 zo2 aa3?/",
        "english": null
      },
