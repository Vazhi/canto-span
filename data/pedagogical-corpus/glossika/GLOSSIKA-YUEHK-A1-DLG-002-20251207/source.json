    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I008",
      "ordinal": 8,
      "itemType": "dialog_turn",
      "turn": 8,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:有新鮮士多啤梨,仲有忌廉同朱古力。",
        "traditional": "有新鮮士多啤梨,仲有忌廉同朱古力。",
        "jyutpingLine": "/Dim3 Jyun4: Jau5 san1 sin1 si6 do1 be1 lei2, zung6 jau5 gei6 lim4 tung4 zyu1 gu2 lik1./",
        "english": null
      },
      "sourceHash": "sha256:c3d2a5262aaa4c890e365858c66a36b22b4e56af2c99a189c7d809f116285909"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I009",
      "ordinal": 9,
      "itemType": "dialog_turn",
      "turn": 9,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:士多啤梨新鮮㗎咩?",
        "traditional": "士多啤梨新鮮㗎咩?",
        "jyutpingLine": "/Aa3 Saan1: Si6 do1 be1 lei2 san1 sin1 gaa3 me1?/",
        "english": null
