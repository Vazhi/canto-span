      "ordinal": 5,
      "itemType": "dialog_turn",
      "turn": 5,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:有啲貴喎,值唔值呀?",
        "traditional": "有啲貴喎,值唔值呀?",
