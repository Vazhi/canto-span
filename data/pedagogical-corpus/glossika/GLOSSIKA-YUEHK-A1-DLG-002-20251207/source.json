      "ordinal": 7,
      "itemType": "dialog_turn",
      "turn": 7,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:有啲咩材料呀?",
        "traditional": "有啲咩材料呀?",
        "jyutpingLine": "/Aa3 Saan1: Jau5 di1 me1 coi4 liu2 aa3?/",
        "english": null
