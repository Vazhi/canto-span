      "sourceHash": "sha256:47f0afad58435992ce00d594237e61e026b9eff1729d0a633cfc61f5e69c0246"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I010",
      "ordinal": 10,
      "itemType": "dialog_turn",
      "turn": 10,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:新鮮呀!今朝先到㗎。",
        "traditional": "新鮮呀!今朝先到㗎。",
        "jyutpingLine": "/Dim3 Jyun4: San1 sin1 aa3! Gam1 ziu1 sin1 dou3 gaa3./",
        "english": null
      },
      "sourceHash": "sha256:72b50a640853a04761f56241ba6eb2649a05c521c9494bfbaf3266df9bbc232d"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I011",
      "ordinal": 11,
      "itemType": "dialog_turn",
      "turn": 11,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:咁呢個值啦!你哋仲有冇其他款式呀?",
        "traditional": "咁呢個值啦!你哋仲有冇其他款式呀?",
        "jyutpingLine": "/Aa3 Saan1: Gam2 ni1 go3 zik6 laa1! Nei5 dei6 zung6 jau5 mou5 kei4 taa1 fun2 sik1 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:d81da242e1eef946009516ab592d9c33a912338bf4146dd6cd2cbc4f2085e149"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I012",
      "ordinal": 12,
      "itemType": "dialog_turn",
      "turn": 12,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:有呀,你想睇咩蛋糕呀?",
        "traditional": "有呀,你想睇咩蛋糕呀?",
        "jyutpingLine": "/Dim3 Jyun4: Jau5 aa3, nei5 soeng2 tai2 me1 daan6 gou1 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:438779d5c44e95229244ebc0c8b16235d693e611762f27d09140057ab2ac7dc6"
