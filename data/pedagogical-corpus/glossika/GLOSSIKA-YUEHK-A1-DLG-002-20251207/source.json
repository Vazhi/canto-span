      "ordinal": 16,
      "itemType": "dialog_turn",
      "turn": 16,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:嗰個平啲,一百二十蚊。",
        "traditional": "嗰個平啲,一百二十蚊。",
        "jyutpingLine": "/Dim3 Jyun4: Go2 go3 peng4 di1, jat1 baak3 ji6 sap6 man1./",
        "english": null
      },
      "sourceHash": "sha256:f443d0fba90917d72de7eb7c251ebe7ddd64d8917d8c50360e573d2e32c8fde8"
