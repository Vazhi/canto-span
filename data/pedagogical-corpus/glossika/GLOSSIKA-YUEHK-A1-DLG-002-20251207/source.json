      "ordinal": 15,
      "itemType": "dialog_turn",
      "turn": 15,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:嗰個幾錢呀?",
        "traditional": "嗰個幾錢呀?",
        "jyutpingLine": "/Aa3 Saan1: Go2 go3 gei2 cin2 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:c3b66573fcba7d13ed686f0345f654143acc98030cb8850bdf5014525e008882"
    },
    {
