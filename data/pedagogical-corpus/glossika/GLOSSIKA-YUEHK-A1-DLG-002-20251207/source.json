      "ordinal": 6,
      "itemType": "dialog_turn",
      "turn": 6,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:好值呀!用咗好多材料。",
        "traditional": "好值呀!用咗好多材料。",
        "jyutpingLine": "/Dim3 Jyun4: Hou2 zik6 aa3! Jung6 zo2 hou2 do1 coi4 liu2./",
