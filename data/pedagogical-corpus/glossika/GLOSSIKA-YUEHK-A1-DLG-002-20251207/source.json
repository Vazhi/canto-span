    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I018",
      "ordinal": 18,
      "itemType": "dialog_turn",
      "turn": 18,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:因為佢細個啲,用嘅材料都少啲。",
        "traditional": "因為佢細個啲,用嘅材料都少啲。",
        "jyutpingLine": "/Dim3 Jyun4: Jan1 wai6 keoi5 sai3 go3 di1, jung6 ge3 coi4 liu2 dou1 siu2 di1./",
        "english": null
      },
      "sourceHash": "sha256:ff153a62d8d2f5db0279e8e6021cb1c53fd4e7a2ed788b34a86b8f60b13613a0"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I019",
      "ordinal": 19,
      "itemType": "dialog_turn",
      "turn": 19,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:明白喇。呢兩個邊個好食啲呀?",
        "traditional": "明白喇。呢兩個邊個好食啲呀?",
        "jyutpingLine": "/Aa3 Saan1: Ming4 baak6 laa3. Ni1 loeng5 go3 bin1 go3 hou2 sik6 di1 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:ef886d19a0a25657a7e429f162f06a293c43904e3bbd0322632e8ac37a365ff6"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I020",
      "ordinal": 20,
      "itemType": "dialog_turn",
      "turn": 20,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:兩個都好好食,不過士多啤梨個更加受歡迎。",
        "traditional": "兩個都好好食,不過士多啤梨個更加受歡迎。",
        "jyutpingLine": "/Dim3 Jyun4: Loeng5 go3 dou1 hou2 hou2 sik6, bat1 gwo3 si6 do1 be1 lei2 go3 gang3 gaa1 sau6 fun1 jing4./",
        "english": null
      },
      "sourceHash": "sha256:e091a6bee67f144a87960be17a604a7f1ca93115747da40d8bfd8f1ff353ef4c"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I021",
      "ordinal": 21,
      "itemType": "dialog_turn",
      "turn": 21,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:點解咁受歡迎呀?",
        "traditional": "點解咁受歡迎呀?",
        "jyutpingLine": "/Aa3 Saan1: Dim2 gaai2 gam3 sau6 fun1 jing4 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:e6a00218baa3e1f3aef80beef805c73d91994e8f6085d0473bb322dd3fca82b6"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I022",
      "ordinal": 22,
      "itemType": "dialog_turn",
      "turn": 22,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:因為啲忌廉唔會太甜,好啱味。",
        "traditional": "因為啲忌廉唔會太甜,好啱味。",
        "jyutpingLine": "/Dim3 Jyun4: Jan1 wai6 di1 gei6 lim4 m4 wui5 taai3 tim4, hou2 ngaam1 mei6./",
        "english": null
      },
      "sourceHash": "sha256:402319fd28d3489f6154eb71b69d7e3dc4e60858dc12e08e7693b0dd4b3913c6"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I023",
      "ordinal": 23,
      "itemType": "dialog_turn",
      "turn": 23,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:咁我買士多啤梨個啦!",
        "traditional": "咁我買士多啤梨個啦!",
        "jyutpingLine": "/Aa3 Saan1: Gam2 ngo5 maai5 si6 do1 be1 lei2 go3 laa1!/",
        "english": null
      },
      "sourceHash": "sha256:9bb4cc3079170713045b2877a9f0cccf776c43c46a894705cad1e7aa5b38614a"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I024",
      "ordinal": 24,
      "itemType": "dialog_turn",
      "turn": 24,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:好呀!你要唔要寫嘢呀?",
        "traditional": "好呀!你要唔要寫嘢呀?",
        "jyutpingLine": "/Dim3 Jyun4: Hou2 aa3! Nei5 jiu3 m4 jiu3 se2 je5 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:abf579f08975a6c357110e447de7dc5bf0ef0039df39859d50efda8c112511b0"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I025",
      "ordinal": 25,
      "itemType": "dialog_turn",
      "turn": 25,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:寫嘢?咩意思呀?",
        "traditional": "寫嘢?咩意思呀?",
        "jyutpingLine": "/Aa3 Saan1: Se2 je5? Me1 ji3 si1 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:8163bf1f1884ceb53f589058917b6a58ce8753e4b2a24c02cfdfa69047828cd8"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I026",
      "ordinal": 26,
      "itemType": "dialog_turn",
      "turn": 26,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:即係喺蛋糕上面寫生日快樂之類。",
        "traditional": "即係喺蛋糕上面寫生日快樂之類。",
        "jyutpingLine": "/Dim3 Jyun4: Zik1 hai6 hai2 daan6 gou1 soeng6 min6 se2 saang1 jat6 faai3 lok6 zi1 leoi6./",
        "english": null
      },
      "sourceHash": "sha256:f7647b4239cbdf98087cffa1782fb4fcdf99ec10e45838a887922fdee0ced87f"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I027",
      "ordinal": 27,
      "itemType": "dialog_turn",
      "turn": 27,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:哦!要呀!寫「生日快樂」,得唔得呀?",
        "traditional": "哦!要呀!寫「生日快樂」,得唔得呀?",
        "jyutpingLine": "/Aa3 Saan1: O4! Jiu3 aa3! Se2 \"saang1 jat6 faai3 lok6\", dak1 m4 dak1 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:f5113f657d5742b956e63f3e18ec2ee96c9622b581c9b95e346555309b69bec8"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I028",
      "ordinal": 28,
      "itemType": "dialog_turn",
      "turn": 28,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:得呀,冇問題。要幾多支蠟燭呀?",
        "traditional": "得呀,冇問題。要幾多支蠟燭呀?",
        "jyutpingLine": "/Dim3 Jyun4: Dak1 aa3, mou5 man6 tai4. Jiu3 gei2 do1 zi1 laap6 zuk1 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:15e1fa4b932264d554a338d63122e22893681f3d2bc38181328477e6fabb4e6b"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I029",
      "ordinal": 29,
      "itemType": "dialog_turn",
      "turn": 29,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:要五支,得唔得呀?",
        "traditional": "要五支,得唔得呀?",
        "jyutpingLine": "/Aa3 Saan1: Jiu3 ng5 zi1, dak1 m4 dak1 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:a18b6cd9d72500cbd723fb90dcde30af8ffdb53dd96a01edab7844c62a00ba31"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-002-20251207-I030",
      "ordinal": 30,
      "itemType": "dialog_turn",
      "turn": 30,
      "speaker": "店員",
      "source": {
