      "ordinal": 14,
      "itemType": "dialog_turn",
      "turn": 14,
      "speaker": "店員",
      "source": {
        "sourceLine": "店員:有呀,嗰個係芒果蛋糕。",
        "traditional": "有呀,嗰個係芒果蛋糕。",
        "jyutpingLine": "/Dim3 Jyun4: Jau5 aa3, go2 go3 hai6 mong1 gwo2 daan6 gou1./",
        "english": null
      },
      "sourceHash": "sha256:8ec9fff55477ac700efcfff9a65337a5ad9111d484f51e580e590300a4d0ca58"
