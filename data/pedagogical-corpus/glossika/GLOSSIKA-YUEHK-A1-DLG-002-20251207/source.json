      "ordinal": 3,
      "itemType": "dialog_turn",
      "turn": 3,
      "speaker": "阿珊",
      "source": {
        "sourceLine": "阿珊:好似好好食咁,幾錢呀?",
        "traditional": "好似好好食咁,幾錢呀?",
        "jyutpingLine": "/Aa3 Saan1: Hou2 ci5 hou2 hou2 sik6 gam2, gei2 cin2 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:f9c1bca6cc17cfcbef0332b9f401503bd328be15bed62944edeea74c50ec25e0"
    },
