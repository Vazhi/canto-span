      "sourceHash": "sha256:bf70227edb07170f085af7457733707830c4dc1db06c8a9d9c28d98b35fc663c",
      "turn": 1,
      "speaker": "家明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-016-20260322-I002",
      "ordinal": 2,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美琪: 佢話聽日要開會。",
