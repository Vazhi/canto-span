  "items": [
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I001",
      "ordinal": 1,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 美玲，我尋日收到個好奇怪嘅工作機會。",
        "traditional": "美玲，我尋日收到個好奇怪嘅工作機會。",
        "jyutpingLine": "/mei5 ling4, ngo5 cam4 jat6 sau1 dou2 go3 hou2 kei4 gwaai3 ge3 gung1 zok3 gei1 wui6./",
        "english": null
      },
      "sourceHash": "sha256:2a1155cc586ad91787c779b780a1af634768916559809e483c519fb71dcfa122",
      "turn": 1,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I002",
      "ordinal": 2,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 奇怪？點奇怪法呀？",
        "traditional": "奇怪？點奇怪法呀？",
        "jyutpingLine": "/kei4 gwaai3? dim2 kei4 gwaai3 faat3 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:867a15b85a545bcf18ae8930fbbe87c6c9ec13246fa80dcdbe01f384278e232b",
      "turn": 2,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I003",
      "ordinal": 3,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 佢哋話人工好高，又話工作好輕鬆。",
        "traditional": "佢哋話人工好高，又話工作好輕鬆。",
        "jyutpingLine": "/keoi5 dei6 waa6 jan4 gung1 hou2 gou1, jau6 waa6 gung1 zok3 hou2 hing1 sung1./",
        "english": null
      },
      "sourceHash": "sha256:ccbcd8f353c14835269e50eceb02cb82c7e2d7006ccb0a0761c74374416dfa8e",
      "turn": 3,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I004",
      "ordinal": 4,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 吓？有幾高人工呀？",
        "traditional": "吓？有幾高人工呀？",
        "jyutpingLine": "/haa2? jau5 gei2 gou1 jan4 gung1 aa3?/",
        "english": null
      },
      "sourceHash": "sha256:ac267889cea8abcbb83876a8f35877d5c52f800c6a6a27037d237715054ca2b4",
      "turn": 4,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I005",
      "ordinal": 5,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 一個月三萬蚊，但係我係新人嚟㗎。",
        "traditional": "一個月三萬蚊，但係我係新人嚟㗎。",
        "jyutpingLine": "/jat1 go3 jyut6 saam1 maan6 man1, daan6 hai6 ngo5 hai6 san1 jan4 lai4 gaa3./",
        "english": null
      },
      "sourceHash": "sha256:ec890653a8f4bc9647953dfb4e27823df970a0507532cddeb2325c202c8e8926",
      "turn": 5,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I006",
      "ordinal": 6,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 三萬？！咁係咪太好喇？",
        "traditional": "三萬？！咁係咪太好喇？",
        "jyutpingLine": "/saam1 maan6?! gam2 hai6 mai6 taai3 hou2 laa3?/",
        "english": null
      },
      "sourceHash": "sha256:827f3b862ba90de8241a25919ad6b2e34f7ff014a59a0757a38bfcb50d4b4d76",
      "turn": 6,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I007",
      "ordinal": 7,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 我都覺得好可疑。你話我信唔信得過佢哋？",
        "traditional": "我都覺得好可疑。你話我信唔信得過佢哋？",
        "jyutpingLine": "/ngo5 dou1 gok3 dak1 hou2 ho2 ji4. nei5 waa6 ngo5 seon3 m4 seon3 dak1 gwo3 keoi5 dei6?/",
        "english": null
      },
      "sourceHash": "sha256:d8bae9167ec4ed29044c1527e6b8fc453e0ad3cf95e5c47dbf80e2f1b54c3396",
      "turn": 7,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I008",
      "ordinal": 8,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 你有冇問清楚係做咩工㗎？",
        "traditional": "你有冇問清楚係做咩工㗎？",
        "jyutpingLine": "/nei5 jau5 mou5 man6 cing1 co2 hai6 zou6 me1 gung1 gaa3?/",
        "english": null
      },
      "sourceHash": "sha256:6991240e1690b8f536b6f4261578523d0dc1aa0e0ddc207277a64d7a8ff00a07",
      "turn": 8,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I009",
      "ordinal": 9,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 佢哋話係做銷售，但係冇講清楚賣乜嘢。",
        "traditional": "佢哋話係做銷售，但係冇講清楚賣乜嘢。",
        "jyutpingLine": "/keoi5 dei6 waa6 hai6 zou6 siu1 sau6, daan6 hai6 mou5 gong2 cing1 co2 maai6 mat1 je5./",
        "english": null
      },
      "sourceHash": "sha256:1e1183589e5ef846ab58a29d2d9def68f56281ae046eb4490bb0b41f8aa654b6",
      "turn": 9,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I010",
      "ordinal": 10,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 咁就有問題喇！正常公司會講清楚㗎。",
        "traditional": "咁就有問題喇！正常公司會講清楚㗎。",
        "jyutpingLine": "/gam2 zau6 jau5 man6 tai4 laa3! zing3 soeng4 gung1 si1 wui5 gong2 cing1 co2 gaa3./",
        "english": null
      },
      "sourceHash": "sha256:f70995ea9c9f540dcdaf24b109528be50d20768922c60109f3bb74f6495d3606",
      "turn": 10,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I011",
      "ordinal": 11,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 仲有，佢哋話要先交一千蚊培訓費。",
        "traditional": "仲有，佢哋話要先交一千蚊培訓費。",
        "jyutpingLine": "/zung6 jau5, keoi5 dei6 waa6 jiu3 sin1 gaau1 jat1 cin1 man1 pui4 fan3 fai3./",
        "english": null
      },
      "sourceHash": "sha256:7411d5a13f3af115b92ea76c566392e418319ae029a056b6875ddcecf2795d39",
      "turn": 11,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I012",
      "ordinal": 12,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 吓？！交錢先？咁一定係呃人㗎喇！",
        "traditional": "吓？！交錢先？咁一定係呃人㗎喇！",
        "jyutpingLine": "/haa2?! gaau1 cin2 sin1? gam2 jat1 ding6 hai6 aak1 jan4 gaa3 laa3!/",
        "english": null
      },
      "sourceHash": "sha256:1e143288290fbe1951a43579fb5e8deb8df5ee4091f9a479249c74daeb9d39d5",
      "turn": 12,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I013",
      "ordinal": 13,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 我都覺得好似係呃人。",
        "traditional": "我都覺得好似係呃人。",
        "jyutpingLine": "/ngo5 dou1 gok3 dak1 hou2 ci5 hai6 aak1 jan4./",
        "english": null
      },
      "sourceHash": "sha256:613c6029488bd25f89756b5de88e82bf9c15f1fb801b0fd64c85c1f619917969",
      "turn": 13,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I014",
      "ordinal": 14,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 你千祈唔好畀錢佢哋呀！",
        "traditional": "你千祈唔好畀錢佢哋呀！",
        "jyutpingLine": "/nei5 cin1 kei4 m4 hou2 bei2 cin2 keoi5 dei6 aa3!/",
        "english": null
      },
      "sourceHash": "sha256:305e8f98cf857883f6826cb49baf07bc9a55e8c689390a40349dff45889f413f",
      "turn": 14,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I015",
      "ordinal": 15,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 但係佢哋話培訓完就會退返畀我。",
        "traditional": "但係佢哋話培訓完就會退返畀我。",
        "jyutpingLine": "/daan6 hai6 keoi5 dei6 waa6 pui4 fan3 jyun4 zau6 wui5 teoi3 faan1 bei2 ngo5./",
        "english": null
      },
      "sourceHash": "sha256:379fe29e1f67d04403c5b84c1b5e36865f8df18ef22f37897205513b37129560",
      "turn": 15,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I016",
      "ordinal": 16,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 邊有咁大隻蛤乸隨街跳㗎？唔好信佢哋！",
        "traditional": "邊有咁大隻蛤乸隨街跳㗎？唔好信佢哋！",
        "jyutpingLine": "/bin1 jau5 gam3 daai6 zek3 gaap3 naa2 ceoi4 gaai1 tiu3 gaa3? m4 hou2 seon3 keoi5 dei6!/",
        "english": null
      },
      "sourceHash": "sha256:9789cd6ade445d3ec718f45a60ea0c599305cf19cb6b2acc4d0b2e9099f1fed8",
      "turn": 16,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I017",
      "ordinal": 17,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 咁我應該點做好？",
        "traditional": "咁我應該點做好？",
        "jyutpingLine": "/gam2 ngo5 jing1 goi1 dim2 zou6 hou2?/",
        "english": null
      },
      "sourceHash": "sha256:4b2d21db580b99ecd3f7afeaabad4c5808cb3442ba885387d27bc4ba78a962c3",
      "turn": 17,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I018",
      "ordinal": 18,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 你有冇上網搵過呢間公司嘅資料？",
        "traditional": "你有冇上網搵過呢間公司嘅資料？",
        "jyutpingLine": "/nei5 jau5 mou5 soeng5 mong5 wan2 gwo3 ni1 gaan1 gung1 si1 ge3 zi1 liu2?/",
        "english": null
      },
      "sourceHash": "sha256:bd03d1fb9b67826a41ff558c4d11c96763fed06ee29bc11114ba9f3c2bfd5baa",
      "turn": 18,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I019",
      "ordinal": 19,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 未呀，我而家即刻搵吓先。",
        "traditional": "未呀，我而家即刻搵吓先。",
        "jyutpingLine": "/mei6 aa3, ngo5 ji4 gaa1 zik1 hak1 wan2 haa5 sin1./",
        "english": null
      },
      "sourceHash": "sha256:7bedec7d40c1546c7690df154d3bfc262c0d4ad77b753803841776a8a801fade",
      "turn": 19,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I020",
      "ordinal": 20,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 你睇吓有冇人投訴過佢哋。",
        "traditional": "你睇吓有冇人投訴過佢哋。",
        "jyutpingLine": "/nei5 tai2 haa5 jau5 mou5 jan4 tau4 sou3 gwo3 keoi5 dei6./",
        "english": null
      },
      "sourceHash": "sha256:bc2bf3e5e08d4ef0d626115c6f1f713a4a37bfd0dd47ab3ea2123e06fa8d4205",
      "turn": 20,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I021",
      "ordinal": 21,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 嘩！網上好多人話畀咗錢之後就搵唔返佢哋。",
        "traditional": "嘩！網上好多人話畀咗錢之後就搵唔返佢哋。",
        "jyutpingLine": "/waa3! mong5 soeng6 hou2 do1 jan4 waa6 bei2 zo2 cin2 zi1 hau6 zau6 wan2 m4 faan1 keoi5 dei6./",
        "english": null
      },
      "sourceHash": "sha256:c8754fa278bdb074fe94c48b3189f848f42f6fb2e42cc9b0066f1d8fe055dc82",
      "turn": 21,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I022",
      "ordinal": 22,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 你睇！我就話係呃人嘅啦！",
        "traditional": "你睇！我就話係呃人嘅啦！",
        "jyutpingLine": "/nei5 tai2! ngo5 zau6 waa6 hai6 aak1 jan4 ge3 laa1!/",
        "english": null
      },
      "sourceHash": "sha256:8979a08d3e703a5ff115bd25868a3819e9529fa9fc74daae3529e94be2ce5533",
      "turn": 22,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I023",
      "ordinal": 23,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 好彩我問咗你先。",
        "traditional": "好彩我問咗你先。",
        "jyutpingLine": "/hou2 coi2 ngo5 man6 zo2 nei5 sin1./",
        "english": null
      },
      "sourceHash": "sha256:7c77a7ebabdec726f7a72b9c20509e6c53f6308aafdf6066e0990e6ad3ccd8b6",
      "turn": 23,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I024",
      "ordinal": 24,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 係呀，你信唔信得過我呢個朋友先？",
        "traditional": "係呀，你信唔信得過我呢個朋友先？",
        "jyutpingLine": "/hai6 aa3, nei5 seon3 m4 seon3 dak1 gwo3 ngo5 ni1 go3 pang4 jau5 sin1?/",
        "english": null
      },
      "sourceHash": "sha256:f7d354e468255d1bbf3be8c8d4af331a9bbcece547c3ce5122fcf36a5f175905",
      "turn": 24,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I025",
      "ordinal": 25,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 當然信你啦！多謝你提醒我。",
        "traditional": "當然信你啦！多謝你提醒我。",
        "jyutpingLine": "/dong1 jin4 seon3 nei5 laa1! do1 ze6 nei5 tai4 sing2 ngo5./",
        "english": null
      },
      "sourceHash": "sha256:321fec5058d4cba83784ad351cd168497a1491f4f6cf366ee617888c2a06e8cf",
      "turn": 25,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I026",
      "ordinal": 26,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 唔使客氣。你而家唔會去啦掛？",
        "traditional": "唔使客氣。你而家唔會去啦掛？",
        "jyutpingLine": "/m4 sai2 haak3 hei3. nei5 ji4 gaa1 m4 wui5 heoi3 laa1 gwaa3?/",
        "english": null
      },
      "sourceHash": "sha256:c9ba14f5e67ba77bd61a8334889a1cac9f3d1d3b77dc6d47321cc53d412987c5",
      "turn": 26,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I027",
      "ordinal": 27,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 梗係唔去啦！我會封鎖佢哋嘅電話。",
        "traditional": "梗係唔去啦！我會封鎖佢哋嘅電話。",
        "jyutpingLine": "/gang2 hai6 m4 heoi3 laa1! ngo5 wui5 fung1 so2 keoi5 dei6 ge3 din6 waa2./",
        "english": null
      },
      "sourceHash": "sha256:d8c44aa24a477e2281abba22954345cb6e27ab7cc8c4491ac55a66ecb45d1802",
      "turn": 27,
      "speaker": "志明"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I028",
      "ordinal": 28,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "美玲: 好呀，最緊要小心啲。",
        "traditional": "好呀，最緊要小心啲。",
        "jyutpingLine": "/hou2 aa3, zeoi3 gan2 jiu3 siu2 sam1 di1./",
        "english": null
      },
      "sourceHash": "sha256:60b78faa7ced216f87b8d3003ad7d9e1c9a4dad8a222c8c6ff250befe41338fd",
      "turn": 28,
      "speaker": "美玲"
    },
    {
      "id": "GLOSSIKA-YUEHK-A1-DLG-015-20260315-I029",
      "ordinal": 29,
      "itemType": "dialog_turn",
      "source": {
        "sourceLine": "志明: 我以後搵工一定會問清楚晒。",
        "traditional": "我以後搵工一定會問清楚晒。",
        "jyutpingLine": "/ngo5 ji5 hau6 wan2 gung1 jat1 ding6 wui5 man6 cing1 co2 saai3./",
