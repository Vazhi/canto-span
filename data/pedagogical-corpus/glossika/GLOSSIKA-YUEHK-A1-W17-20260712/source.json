  "sourceClaims": {
    "phonicsHeading": "/yː/ (yu) vs /uː/ (u)",
    "phonicsStatement": "The front rounded vowel /yː/ (written yu in Jyutping) contrasts with back rounded /uː/. This distinction exists in Mandarin (ü vs u) but is realized differently in Cantonese.",
    "status": "immutable_source_claim_requires_independent_verification"
  },
