    {"itemType":"dialog_turn","turn":31,"speaker":"阿珊","source":{"sourceLine":"阿珊:多謝!你哋服務真係好好!","traditional":"多謝!你哋服務真係好好!","jyutpingLine":"/Aa3 Saan1: Do1 ze6! Nei5 dei6 fuk6 mou6 zan1 hai6 hou2 hou2!/","english":null}},
    {"itemType":"dialog_turn","turn":32,"speaker":"店員","source":{"sourceLine":"店員:唔使客氣!幾時要呀?","traditional":"唔使客氣!幾時要呀?","jyutpingLine":"/Dim3 Jyun4: M4 sai2 haak3 hei3! Gei2 si4 jiu3 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":33,"speaker":"阿珊","source":{"sourceLine":"阿珊:聽日下晝三點鐘得唔得呀?","traditional":"聽日下晝三點鐘得唔得呀?","jyutpingLine":"/Aa3 Saan1: Ting1 jat6 haa6 zau3 saam1 dim2 zung1 dak1 m4 dak1 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":34,"speaker":"店員","source":{"sourceLine":"店員:得呀,你嚟攞就得喇。","traditional":"得呀,你嚟攞就得喇。","jyutpingLine":"/Dim3 Jyun4: Dak1 aa3, nei5 lai4 lo2 zau6 dak1 laa3./","english":null}},
    {"itemType":"dialog_turn","turn":35,"speaker":"阿珊","source":{"sourceLine":"阿珊:好呀!要唔要畀訂金呀?","traditional":"好呀!要唔要畀訂金呀?","jyutpingLine":"/Aa3 Saan1: Hou2 aa3! Jiu3 m4 jiu3 bei2 ding6 gam1 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":36,"speaker":"店員","source":{"sourceLine":"店員:唔使訂金,你嚟到畀錢就得喇。","traditional":"唔使訂金,你嚟到畀錢就得喇。","jyutpingLine":"/Dim3 Jyun4: M4 sai2 ding6 gam1, nei5 lai4 dou3 bei2 cin2 zau6 dak1 laa3./","english":null}},
    {"itemType":"dialog_turn","turn":37,"speaker":"阿珊","source":{"sourceLine":"阿珊:好呀,多謝晒!聽日見!","traditional":"好呀,多謝晒!聽日見!","jyutpingLine":"/Aa3 Saan1: Hou2 aa3, do1 ze6 saai3! Ting1 jat6 gin3!/","english":null}},
    {"itemType":"dialog_turn","turn":38,"speaker":"店員","source":{"sourceLine":"店員:聽日見!拜拜!","traditional":"聽日見!拜拜!","jyutpingLine":"/Dim3 Jyun4: Ting1 jat6 gin3! Baai1 baai3!/","english":null}},

