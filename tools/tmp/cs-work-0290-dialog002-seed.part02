    {"itemType":"dialog_turn","turn":21,"speaker":"阿珊","source":{"sourceLine":"阿珊:點解咁受歡迎呀?","traditional":"點解咁受歡迎呀?","jyutpingLine":"/Aa3 Saan1: Dim2 gaai2 gam3 sau6 fun1 jing4 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":22,"speaker":"店員","source":{"sourceLine":"店員:因為啲忌廉唔會太甜,好啱味。","traditional":"因為啲忌廉唔會太甜,好啱味。","jyutpingLine":"/Dim3 Jyun4: Jan1 wai6 di1 gei6 lim4 m4 wui5 taai3 tim4, hou2 ngaam1 mei6./","english":null}},
    {"itemType":"dialog_turn","turn":23,"speaker":"阿珊","source":{"sourceLine":"阿珊:咁我買士多啤梨個啦!","traditional":"咁我買士多啤梨個啦!","jyutpingLine":"/Aa3 Saan1: Gam2 ngo5 maai5 si6 do1 be1 lei2 go3 laa1!/","english":null}},
    {"itemType":"dialog_turn","turn":24,"speaker":"店員","source":{"sourceLine":"店員:好呀!你要唔要寫嘢呀?","traditional":"好呀!你要唔要寫嘢呀?","jyutpingLine":"/Dim3 Jyun4: Hou2 aa3! Nei5 jiu3 m4 jiu3 se2 je5 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":25,"speaker":"阿珊","source":{"sourceLine":"阿珊:寫嘢?咩意思呀?","traditional":"寫嘢?咩意思呀?","jyutpingLine":"/Aa3 Saan1: Se2 je5? Me1 ji3 si1 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":26,"speaker":"店員","source":{"sourceLine":"店員:即係喺蛋糕上面寫生日快樂之類。","traditional":"即係喺蛋糕上面寫生日快樂之類。","jyutpingLine":"/Dim3 Jyun4: Zik1 hai6 hai2 daan6 gou1 soeng6 min6 se2 saang1 jat6 faai3 lok6 zi1 leoi6./","english":null}},
    {"itemType":"dialog_turn","turn":27,"speaker":"阿珊","source":{"sourceLine":"阿珊:哦!要呀!寫「生日快樂」,得唔得呀?","traditional":"哦!要呀!寫「生日快樂」,得唔得呀?","jyutpingLine":"/Aa3 Saan1: O4! Jiu3 aa3! Se2 \"saang1 jat6 faai3 lok6\", dak1 m4 dak1 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":28,"speaker":"店員","source":{"sourceLine":"店員:得呀,冇問題。要幾多支蠟燭呀?","traditional":"得呀,冇問題。要幾多支蠟燭呀?","jyutpingLine":"/Dim3 Jyun4: Dak1 aa3, mou5 man6 tai4. Jiu3 gei2 do1 zi1 laap6 zuk1 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":29,"speaker":"阿珊","source":{"sourceLine":"阿珊:要五支,得唔得呀?","traditional":"要五支,得唔得呀?","jyutpingLine":"/Aa3 Saan1: Jiu3 ng5 zi1, dak1 m4 dak1 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":30,"speaker":"店員","source":{"sourceLine":"店員:得呀!我哋送埋蠟燭畀你。","traditional":"得呀!我哋送埋蠟燭畀你。","jyutpingLine":"/Dim3 Jyun4: Dak1 aa3! Ngo5 dei6 sung3 maai4 laap6 zuk1 bei2 nei5./","english":null}},
