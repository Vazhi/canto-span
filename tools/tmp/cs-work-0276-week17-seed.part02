    {"section":"vocabulary_and_situations","subsection":"situation_patterns","itemType":"sentence","register":"casual","source":{"traditional":"我最近好大壓力。","jyutping":"Ngo5 zeoi3 gan6 hou2 daai6 aat3 lik6.","morphemeGloss":"I most-recent very big pressure","english":"I've been under a lot of stress lately."}},
    {"section":"vocabulary_and_situations","subsection":"situation_patterns","itemType":"sentence","register":"casual","source":{"traditional":"你攰唔攰？不如休息吓。","jyutping":"Nei5 gui6 m4 gui6? bat1 jyu4 jau1 sik1 haa5.","morphemeGloss":"you tired NEG tired why-not rest briefly","english":"Are you tired? Why don't you take a break."}},
    {"section":"vocabulary_and_situations","subsection":"situation_patterns","itemType":"sentence","register":"casual","source":{"traditional":"考完試好開心！","jyutping":"Haau2 jyun4 si3 hou2 hoi1 sam1!","morphemeGloss":"finish exam very happy","english":"So happy the exams are over!"}},
    {"section":"vocabulary_and_situations","subsection":"situation_patterns","itemType":"sentence","register":"casual","source":{"traditional":"佢今日好似好嬲。","jyutping":"Keoi5 gam1 jat6 hou2 ci5 hou2 nau1.","morphemeGloss":"he today very seem very angry","english":"He seems really angry today."}},

    {"section":"vocabulary_and_situations","subsection":"mini_dialog","itemType":"dialog_turn","register":"casual","dialogTurn":1,"source":{"traditional":"你塊面好似唔開心噃。","jyutping":"Nei5 faai3 min6 hou2 ci5 m4 hoi1 sam1 bo3.","morphemeGloss":"you CLF face very seem NEG happy PART","english":"You look unhappy."}},
    {"section":"vocabulary_and_situations","subsection":"mini_dialog","itemType":"dialog_turn","register":"casual","dialogTurn":2,"source":{"traditional":"係呀，我最近好大壓力。","jyutping":"Hai6 aa3, ngo5 zeoi3 gan6 hou2 daai6 aat3 lik6.","morphemeGloss":"yes PART I most-recent very big pressure","english":"Yeah, I've been really stressed out lately."}},
    {"section":"vocabulary_and_situations","subsection":"mini_dialog","itemType":"dialog_turn","register":"casual","dialogTurn":3,"source":{"traditional":"點解呀？做嘢太忙？","jyutping":"Dim2 gaai2 aa3? zou6 je5 taai3 mong4?","morphemeGloss":"why PART do thing too busy","english":"Why? Too busy with work?"}},
    {"section":"vocabulary_and_situations","subsection":"mini_dialog","itemType":"dialog_turn","register":"casual","dialogTurn":4,"source":{"traditional":"係呀，日日OT到好夜。","jyutping":"Hai6 aa3, jat6 jat6 ou1 ti1 dou3 hou2 je6.","morphemeGloss":"yes PART day-day overtime until very late","english":"Yeah, working overtime every day until very late."}},
    {"section":"vocabulary_and_situations","subsection":"mini_dialog","itemType":"dialog_turn","register":"casual","dialogTurn":5,"source":{"traditional":"你要注意身體，唞多啲呀。","jyutping":"Nei5 jiu3 zyu3 ji3 san1 tai2, tau2 do1 di1 aa3.","morphemeGloss":"you need pay-attention body rest more a-bit PART","english":"Take care of yourself, get more rest."}},

    {"section":"grammar_patterns","subsection":"prepositions","itemType":"grammar_phrase","source":{"preposition":"喺","jyutping":"hai2","meaning":"at; in","exampleTraditional":"喺屋企","exampleJyutping":"hai2 uk1 kei2","exampleEnglish":"at home"}},
    {"section":"grammar_patterns","subsection":"prepositions","itemType":"grammar_phrase","source":{"preposition":"去","jyutping":"heoi3","meaning":"to (direction)","exampleTraditional":"去香港","exampleJyutping":"heoi3 hoeng1 gong2","exampleEnglish":"to Hong Kong"}},
    {"section":"grammar_patterns","subsection":"prepositions","itemType":"grammar_phrase","source":{"preposition":"由","jyutping":"jau4","meaning":"from","exampleTraditional":"由九龍去港島","exampleJyutping":"jau4 gau2 lung4 heoi3 gong2 dou2","exampleEnglish":"from Kowloon to HK Island"}},
    {"section":"grammar_patterns","subsection":"prepositions","itemType":"grammar_phrase","source":{"preposition":"同","jyutping":"tung4","meaning":"with","exampleTraditional":"同朋友","exampleJyutping":"tung4 pang4 jau5","exampleEnglish":"with friends"}},
    {"section":"grammar_patterns","subsection":"prepositions","itemType":"grammar_phrase","source":{"preposition":"畀","jyutping":"bei2","meaning":"to; for (giving)","exampleTraditional":"畀你","exampleJyutping":"bei2 nei5","exampleEnglish":"for you"}},
    {"section":"grammar_patterns","subsection":"prepositions","itemType":"grammar_phrase","source":{"preposition":"用","jyutping":"jung6","meaning":"with (using)","exampleTraditional":"用筷子","exampleJyutping":"jung6 kwaai3 zi2","exampleEnglish":"with chopsticks"}},
    {"section":"grammar_patterns","subsection":"prepositions","itemType":"grammar_phrase","source":{"preposition":"對","jyutping":"deoi3","meaning":"toward","exampleTraditional":"對佢好","exampleJyutping":"deoi3 keoi5 hou2","exampleEnglish":"be good to him/her"}},
    {"section":"grammar_patterns","subsection":"prepositions","itemType":"grammar_phrase","source":{"preposition":"除咗","jyutping":"ceoi4 zo2","meaning":"except","exampleTraditional":"除咗佢","exampleJyutping":"ceoi4 zo2 keoi5","exampleEnglish":"except him/her"}},

    {"section":"grammar_patterns","subsection":"preposition_examples","itemType":"sentence","register":"standard","source":{"traditional":"我喺香港住。","jyutping":"ngo5 hai2 hoeng1 gong2 zyu6","morphemeGloss":"I LOC Hong.Kong live","english":"I live in Hong Kong."}},
