  "records": [
    {"itemType":"dialog_turn","turn":1,"speaker":"阿珊","source":{"sourceLine":"阿珊:哇,呢個蛋糕好靚呀!","traditional":"哇,呢個蛋糕好靚呀!","jyutpingLine":"/Aa3 Saan1: Waa1, ni1 go3 daan6 gou1 hou2 leng3 aa3!/","english":null}},
    {"itemType":"dialog_turn","turn":2,"speaker":"店員","source":{"sourceLine":"店員:係呀,呢個係我哋新款。","traditional":"係呀,呢個係我哋新款。","jyutpingLine":"/Dim3 Jyun4: Hai6 aa3, ni1 go3 hai6 ngo5 dei6 san1 fun2./","english":null}},
    {"itemType":"dialog_turn","turn":3,"speaker":"阿珊","source":{"sourceLine":"阿珊:好似好好食咁,幾錢呀?","traditional":"好似好好食咁,幾錢呀?","jyutpingLine":"/Aa3 Saan1: Hou2 ci5 hou2 hou2 sik6 gam2, gei2 cin2 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":4,"speaker":"店員","source":{"sourceLine":"店員:呢個一百八十蚊。","traditional":"呢個一百八十蚊。","jyutpingLine":"/Dim3 Jyun4: Ni1 go3 jat1 baak3 baat3 sap6 man1./","english":null}},
    {"itemType":"dialog_turn","turn":5,"speaker":"阿珊","source":{"sourceLine":"阿珊:有啲貴喎,值唔值呀?","traditional":"有啲貴喎,值唔值呀?","jyutpingLine":"/Aa3 Saan1: Jau5 di1 gwai3 wo3, zik6 m4 zik6 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":6,"speaker":"店員","source":{"sourceLine":"店員:好值呀!用咗好多材料。","traditional":"好值呀!用咗好多材料。","jyutpingLine":"/Dim3 Jyun4: Hou2 zik6 aa3! Jung6 zo2 hou2 do1 coi4 liu2./","english":null}},
    {"itemType":"dialog_turn","turn":7,"speaker":"阿珊","source":{"sourceLine":"阿珊:有啲咩材料呀?","traditional":"有啲咩材料呀?","jyutpingLine":"/Aa3 Saan1: Jau5 di1 me1 coi4 liu2 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":8,"speaker":"店員","source":{"sourceLine":"店員:有新鮮士多啤梨,仲有忌廉同朱古力。","traditional":"有新鮮士多啤梨,仲有忌廉同朱古力。","jyutpingLine":"/Dim3 Jyun4: Jau5 san1 sin1 si6 do1 be1 lei2, zung6 jau5 gei6 lim4 tung4 zyu1 gu2 lik1./","english":null}},
    {"itemType":"dialog_turn","turn":9,"speaker":"阿珊","source":{"sourceLine":"阿珊:士多啤梨新鮮㗎咩?","traditional":"士多啤梨新鮮㗎咩?","jyutpingLine":"/Aa3 Saan1: Si6 do1 be1 lei2 san1 sin1 gaa3 me1?/","english":null}},
    {"itemType":"dialog_turn","turn":10,"speaker":"店員","source":{"sourceLine":"店員:新鮮呀!今朝先到㗎。","traditional":"新鮮呀!今朝先到㗎。","jyutpingLine":"/Dim3 Jyun4: San1 sin1 aa3! Gam1 ziu1 sin1 dou3 gaa3./","english":null}},
