    {"itemType":"dialog_turn","turn":11,"speaker":"阿珊","source":{"sourceLine":"阿珊:咁呢個值啦!你哋仲有冇其他款式呀?","traditional":"咁呢個值啦!你哋仲有冇其他款式呀?","jyutpingLine":"/Aa3 Saan1: Gam2 ni1 go3 zik6 laa1! Nei5 dei6 zung6 jau5 mou5 kei4 taa1 fun2 sik1 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":12,"speaker":"店員","source":{"sourceLine":"店員:有呀,你想睇咩蛋糕呀?","traditional":"有呀,你想睇咩蛋糕呀?","jyutpingLine":"/Dim3 Jyun4: Jau5 aa3, nei5 soeng2 tai2 me1 daan6 gou1 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":13,"speaker":"阿珊","source":{"sourceLine":"阿珊:有冇芒果蛋糕呀?","traditional":"有冇芒果蛋糕呀?","jyutpingLine":"/Aa3 Saan1: Jau5 mou5 mong1 gwo2 daan6 gou1 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":14,"speaker":"店員","source":{"sourceLine":"店員:有呀,嗰個係芒果蛋糕。","traditional":"有呀,嗰個係芒果蛋糕。","jyutpingLine":"/Dim3 Jyun4: Jau5 aa3, go2 go3 hai6 mong1 gwo2 daan6 gou1./","english":null}},
    {"itemType":"dialog_turn","turn":15,"speaker":"阿珊","source":{"sourceLine":"阿珊:嗰個幾錢呀?","traditional":"嗰個幾錢呀?","jyutpingLine":"/Aa3 Saan1: Go2 go3 gei2 cin2 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":16,"speaker":"店員","source":{"sourceLine":"店員:嗰個平啲,一百二十蚊。","traditional":"嗰個平啲,一百二十蚊。","jyutpingLine":"/Dim3 Jyun4: Go2 go3 peng4 di1, jat1 baak3 ji6 sap6 man1./","english":null}},
    {"itemType":"dialog_turn","turn":17,"speaker":"阿珊","source":{"sourceLine":"阿珊:點解平咗呀?","traditional":"點解平咗呀?","jyutpingLine":"/Aa3 Saan1: Dim2 gaai2 peng4 zo2 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":18,"speaker":"店員","source":{"sourceLine":"店員:因為佢細個啲,用嘅材料都少啲。","traditional":"因為佢細個啲,用嘅材料都少啲。","jyutpingLine":"/Dim3 Jyun4: Jan1 wai6 keoi5 sai3 go3 di1, jung6 ge3 coi4 liu2 dou1 siu2 di1./","english":null}},
    {"itemType":"dialog_turn","turn":19,"speaker":"阿珊","source":{"sourceLine":"阿珊:明白喇。呢兩個邊個好食啲呀?","traditional":"明白喇。呢兩個邊個好食啲呀?","jyutpingLine":"/Aa3 Saan1: Ming4 baak6 laa3. Ni1 loeng5 go3 bin1 go3 hou2 sik6 di1 aa3?/","english":null}},
    {"itemType":"dialog_turn","turn":20,"speaker":"店員","source":{"sourceLine":"店員:兩個都好好食,不過士多啤梨個更加受歡迎。","traditional":"兩個都好好食,不過士多啤梨個更加受歡迎。","jyutpingLine":"/Dim3 Jyun4: Loeng5 go3 dou1 hou2 hou2 sik6, bat1 gwo3 si6 do1 be1 lei2 go3 gang3 gaa1 sau6 fun1 jing4./","english":null}},
